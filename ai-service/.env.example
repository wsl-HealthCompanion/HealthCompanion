# AI Service 环境变量配置

# LLM API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Milvus 向量数据库
MILVUS_ADDRESS=localhost:19530

# Task 4: 可信健康 RAG
# RAG_ENABLED=true 开启检索增强（需要 Milvus 已部署且知识库已 ingestion）
# RAG_KB_VERSION 知识库版本：ingestion 更新知识库后递增，使旧 citation 缓存失效
RAG_ENABLED=false
RAG_KB_VERSION=v1

# 可观测(可选)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 服务端口
PORT=8000
