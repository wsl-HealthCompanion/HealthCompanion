# 后端 API (NestJS)
VITE_API_BASE=http://localhost:3000/api/v1

# 用户数字人会话、控制和动态播放地址均由 NestJS 后端管理。
# H5 不再配置 LiveTalking 地址、固定 session ID 或固定 hdh/livestream 播放地址。


# 数字人运行时: livetalking | xmov
# 留空时：配置了 Xmov 凭据就自动用 xmov，否则回退 livetalking。
VITE_AVATAR_PROVIDER=

# XmovAvatar / 魔珐星云具身驱动
# 真实 App ID / App Secret 仅写入本地 .env.local，不要提交到 Git。
VITE_XMOV_APP_ID=
VITE_XMOV_APP_SECRET=
VITE_XMOV_SDK_URL=https://media.xingyun3d.com/xingyun3d/general/litesdk/xmovAvatar@latest.js
VITE_XMOV_GATEWAY_URL=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session
VITE_XMOV_AUTHORIZATION=888jn

# Task 1 调试按钮。比赛正式构建时保持 false。
VITE_XMOV_SHOW_DEV_CONTROLS=false
